# ---------------------------------------------------------------------------
# Software Factory Studio — Environment Variables Template
# Copy this file to .env and adjust values for your environment.
# ---------------------------------------------------------------------------

# Backend Simulation Mode
# - 'true' (default): Runs against the in-browser MSW mock service worker and simulated backend.
# - 'false': Connects to a real production/staging backend server and strips MSW from the build.
VITE_USE_MOCKS=true

# Backend REST API Base URL
# Base path or full URL for factory endpoints (e.g., http://localhost:8080/api/v1)
VITE_API_BASE_URL=/api/v1

# Authentication / SSO Login URL
# Redirect destination when a session token is missing or expired in non-mock mode.
VITE_LOGIN_URL=/auth/login

# Default Repository (Optional)
# Target repository for quick local onboarding and testing
VITE_DEFAULT_REPO=BboyAkers/Software-Factory-Studio
